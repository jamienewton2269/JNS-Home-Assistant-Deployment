<Window x:Class="JnsSshTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vt="clr-namespace:VirtualTerminal;assembly=VirtualTerminal.WPF"
        xmlns:local="clr-namespace:JnsSshTerminal.Controls"
        Title="JNS SSH Terminal"
        Width="1280"
        Height="820"
        MinWidth="920"
        MinHeight="620"
        Background="#17191C"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style x:Key="TerminalScrollPageButtonStyle"
               TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="#15191E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border x:Name="PageSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PageSurface" Property="Background" Value="#252C34"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PageSurface" Property="Background" Value="#303945"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TerminalScrollArrowButtonStyle"
               TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#DCE2E9"/>
            <Setter Property="Background" Value="#252B32"/>
            <Setter Property="BorderBrush" Value="#4A535E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border x:Name="ArrowSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowSurface" Property="Background" Value="#39434E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ArrowSurface" Property="Background" Value="#586675"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TerminalScrollThumbStyle"
               TargetType="{x:Type Thumb}">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Margin" Value="1,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#D5DCE4"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="9" Height="2" Background="#303842" CornerRadius="1" Margin="0,1"/>
                                <Border Width="9" Height="2" Background="#303842" CornerRadius="1" Margin="0,1"/>
                                <Border Width="9" Height="2" Background="#303842" CornerRadius="1" Margin="0,1"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#F4F7FA"/>
                                <Setter TargetName="ThumbSurface" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="White"/>
                                <Setter TargetName="ThumbSurface" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="ThumbSurface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TerminalScrollBarStyle"
               TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Background" Value="#101317"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#343B44"
                                BorderThickness="1,0,0,0">
                            <Grid Margin="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="22"/>
                                </Grid.RowDefinitions>

                                <RepeatButton Grid.Row="0"
                                              Content="▲"
                                              Style="{StaticResource TerminalScrollArrowButtonStyle}"
                                              Command="{x:Static ScrollBar.LineUpCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              ToolTip="Scroll up"/>

                                <Track x:Name="PART_Track"
                                       Grid.Row="1"
                                       IsDirectionReversed="True"
                                       Focusable="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource TerminalScrollPageButtonStyle}"
                                                      Command="{x:Static ScrollBar.PageUpCommand}"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource TerminalScrollThumbStyle}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource TerminalScrollPageButtonStyle}"
                                                      Command="{x:Static ScrollBar.PageDownCommand}"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>

                                <RepeatButton Grid.Row="2"
                                              Content="▼"
                                              Style="{StaticResource TerminalScrollArrowButtonStyle}"
                                              Command="{x:Static ScrollBar.LineDownCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              ToolTip="Scroll down"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ConnectionPanelColumn"
                              Width="275"
                              MinWidth="220"
                              MaxWidth="520"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="350"/>
            <ColumnDefinition x:Name="HistoryColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#202329"
                BorderBrush="#343941"
                BorderThickness="0,0,1,0"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="JNS SSH" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="simple • local • no cloud" Margin="0,0,0,18" Foreground="#AAB1BC"/>
                    <TextBlock Text="Connect / disconnect applies to the active terminal tab."
                               Margin="0,0,0,14"
                               Foreground="#AAB1BC"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Saved host" Foreground="#D5D8DC"/>
                    <ComboBox x:Name="SavedHosts"
                              Margin="0,4,0,8"
                              SelectionChanged="SavedHosts_SelectionChanged"/>

                    <TextBlock Text="Name" Foreground="#D5D8DC"/>
                    <TextBox x:Name="ProfileName" Margin="0,4,0,8"/>

                    <TextBlock Text="Host / IP" Foreground="#D5D8DC"/>
                    <TextBox x:Name="HostName" Margin="0,4,0,8"/>

                    <TextBlock Text="Port" Foreground="#D5D8DC"/>
                    <TextBox x:Name="Port" Text="22" Margin="0,4,0,8"/>

                    <TextBlock Text="Username" Foreground="#D5D8DC"/>
                    <TextBox x:Name="Username" Margin="0,4,0,8"/>

                    <TextBlock Text="Password / key passphrase" Foreground="#D5D8DC"/>
                    <PasswordBox x:Name="Password" Padding="5" Margin="0,4,0,6"/>
                    <CheckBox x:Name="RememberPassword"
                              Content="Remember SSH account password securely"
                              Foreground="#D5D8DC"
                              Margin="0,0,0,4"/>
                    <TextBlock x:Name="CredentialStatusText"
                               Text="Saved password status: not checked"
                               Foreground="#8E96A3"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <Button Content="Forget Saved Password"
                            Click="ForgetSavedPassword_Click"
                            Margin="0,0,0,10"/>

                    <TextBlock Text="Private key (optional)" Foreground="#D5D8DC"/>
                    <Grid Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="KeyFile" Grid.Column="0" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="…" Width="34" Click="BrowseKey_Click"/>
                    </Grid>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Generate Secure Key"
                                Click="GenerateSecureKey_Click"/>
                        <Button Content="Copy Public Key"
                                Click="CopyPublicKey_Click"/>
                    </WrapPanel>

                    <WrapPanel>
                        <Button Content="Save Host" MinWidth="105" Click="SaveHost_Click"/>
                        <Button Content="Connect" MinWidth="105" Click="Connect_Click"/>
                    </WrapPanel>

                    <Separator Margin="0,8,0,8"/>
                    <TextBlock Text="Persistent remote sessions" Foreground="#D5D8DC"/>
                    <ComboBox x:Name="DetachedSessions"
                              Margin="0,4,0,8"
                              SelectionChanged="DetachedSessions_SelectionChanged"/>
                    <WrapPanel>
                        <Button Content="Refresh / Discover"
                                Click="RefreshSessions_Click"/>
                        <Button Content="Remove Ended"
                                Click="RemoveEndedSession_Click"/>
                    </WrapPanel>
                    <Button Content="Reattach Selected Session"
                            Click="ReattachDetached_Click"
                            Margin="0,0,0,8"/>
                    <TextBlock Text="Registry survives Windows restarts. Refresh asks the remote tmux server which JNS sessions actually still exist."
                               Foreground="#AAB1BC"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <Separator/>
                    <TextBlock Text="Remembered SSH account passwords use Windows Credential Manager. They are never written to JNS JSON or the registry."
                               Margin="0,12,0,4"
                               Foreground="#AAB1BC"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="First connection shows the SHA256 host key. Later mismatches are rejected."
                               Foreground="#AAB1BC"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#343941"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False"
                      Cursor="SizeWE"
                      ToolTip="Drag to resize the connection/session panel"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#202329"
                    Padding="8"
                    BorderBrush="#343941"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <WrapPanel DockPanel.Dock="Left">
                        <Button Content="+ New Terminal"
                                FontWeight="SemiBold"
                                Click="NewTerminal_Click"/>
                        <Button Content="Detach &amp; Close"
                                Click="DetachClose_Click"/>
                        <Button Content="Kill Remote Session"
                                Click="KillSession_Click"/>
                        <Button Content="Select All" Click="SelectAll_Click"/>
                        <Button Content="Copy" Click="Copy_Click"/>
                        <Button Content="Paste" Click="Paste_Click"/>
                        <Button Content="Clear Screen Buffer"
                                FontWeight="SemiBold"
                                Click="ClearBuffer_Click"/>
                        <Button Content="Command History" Click="ToggleHistory_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="StatusText"
                               DockPanel.Dock="Right"
                               Text="Terminal 1: Disconnected"
                               Foreground="#AAB1BC"
                               VerticalAlignment="Center"
                               Margin="10,0,4,6"/>
                </DockPanel>
            </Border>

            <TabControl x:Name="TerminalTabs"
                        Grid.Row="1"
                        Background="#080A0C"
                        BorderBrush="#343941"
                        SelectionChanged="TerminalTabs_SelectionChanged">
                <TabItem x:Name="TerminalTab1" Header="Terminal 1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                        </Grid.ColumnDefinitions>
                        <local:JnsTerminalControl x:Name="Terminal1"
                                                  Grid.Column="0"
                                                  AllowDirectInput="True"
                                                  ScrollDownVisible="True"
                                                  ScrollbackLines="3000"
                                                  Background="#080A0C"
                                                  Foreground="#E7E9EC"
                                                  FontFamily="Cascadia Mono"
                                                  FontSize="14"
                                                  PreviewMouseRightButtonDown="Terminal_PreviewMouseRightButtonDown"/>
                        <ScrollBar x:Name="TerminalScrollBar1"
                                   Grid.Column="1"
                                   Style="{StaticResource TerminalScrollBarStyle}"
                                   Orientation="Vertical"
                                   Minimum="0"
                                   Maximum="0"
                                   SmallChange="3"
                                   LargeChange="25"
                                   ValueChanged="TerminalScrollBar_ValueChanged"/>
                    </Grid>
                </TabItem>
                <TabItem x:Name="TerminalTab2" Header="Terminal 2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                        </Grid.ColumnDefinitions>
                        <local:JnsTerminalControl x:Name="Terminal2"
                                                  Grid.Column="0"
                                                  AllowDirectInput="True"
                                                  ScrollDownVisible="True"
                                                  ScrollbackLines="3000"
                                                  Background="#080A0C"
                                                  Foreground="#E7E9EC"
                                                  FontFamily="Cascadia Mono"
                                                  FontSize="14"
                                                  PreviewMouseRightButtonDown="Terminal_PreviewMouseRightButtonDown"/>
                        <ScrollBar x:Name="TerminalScrollBar2"
                                   Grid.Column="1"
                                   Style="{StaticResource TerminalScrollBarStyle}"
                                   Orientation="Vertical"
                                   Minimum="0"
                                   Maximum="0"
                                   SmallChange="3"
                                   LargeChange="25"
                                   ValueChanged="TerminalScrollBar_ValueChanged"/>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2"
                    Background="#202329"
                    BorderBrush="#343941"
                    BorderThickness="0,1,0,0"
                    Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Command Bar — sends to the active terminal tab; commands sent here are added to history."
                                   Foreground="#AAB1BC"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="CommandEntry"
                                 MinHeight="34"
                                 MaxHeight="130"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono"
                                 FontSize="13"
                                 KeyDown="CommandEntry_KeyDown"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="8,22,0,0"
                                VerticalAlignment="Top">
                        <Button Content="Stop Current (^C)"
                                MinWidth="90"
                                Click="StopCommand_Click"/>
                        <Button Content="Send"
                                MinWidth="80"
                                Click="SendCommand_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StatusBar Grid.Row="3" Background="#17191C" Foreground="#AAB1BC">
                <StatusBarItem>
                    <TextBlock Text="Independent SSH tabs • 3000-line scrollback + scrollbar • Detach keeps tmux alive • Ctrl+C = copy"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>

        <Border Grid.Column="3"
                Background="#202329"
                BorderBrush="#343941"
                BorderThickness="1,0,0,0"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Command History"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <Button Content="×"
                            DockPanel.Dock="Right"
                            Width="32"
                            Margin="8,0,0,0"
                            Click="ToggleHistory_Click"/>
                </DockPanel>

                <ListBox x:Name="HistoryList"
                         Grid.Row="1"
                         Background="#17191C"
                         Foreground="#E7E9EC"
                         BorderBrush="#343941"
                         ItemsSource="{Binding}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding When, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           FontSize="10"
                                           Foreground="#8E96A3"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button Content="Load" Click="LoadHistory_Click"/>
                    <Button Content="Pin / Unpin" Click="PinHistory_Click"/>
                    <Button Content="Delete" Click="DeleteHistory_Click"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
